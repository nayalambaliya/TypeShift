<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AIKeyboard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ts_bg</item>
        <item name="android:statusBarColor">@color/ts_bg</item>
        <item name="android:navigationBarColor">@color/ts_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Splash screen shown on cold start, then hands off to the main theme. -->
    <style name="Theme.AIKeyboard.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ts_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AIKeyboard</item>
    </style>
</resources>
