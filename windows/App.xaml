<Application x:Class="TypeShift.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Core colors -->
            <SolidColorBrush x:Key="BgBrush"      Color="#000000"/>
            <SolidColorBrush x:Key="Surf1Brush"   Color="#0D0D0D"/>
            <SolidColorBrush x:Key="Surf2Brush"   Color="#1A1A1A"/>
            <SolidColorBrush x:Key="Surf3Brush"   Color="#242424"/>
            <SolidColorBrush x:Key="AccentBrush"  Color="#7B61FF"/>
            <SolidColorBrush x:Key="AccentLtBrush" Color="#9E8FFF"/>
            <SolidColorBrush x:Key="PrimBrush"    Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SecBrush"     Color="#8A8A8A"/>
            <SolidColorBrush x:Key="TertBrush"    Color="#444444"/>
            <SolidColorBrush x:Key="GreenBrush"   Color="#34C759"/>
            <SolidColorBrush x:Key="RedBrush"     Color="#FF3B30"/>
            <SolidColorBrush x:Key="OrangeBrush"  Color="#FF9F0A"/>

            <!-- ScrollBar style (minimal dark) -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="#0D0D0D"/>
                <Setter Property="Width" Value="6"/>
            </Style>

            <!-- Button base -->
            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="Background"   Value="#7B61FF"/>
                <Setter Property="Foreground"   Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"      Value="20,0"/>
                <Setter Property="Height"       Value="38"/>
                <Setter Property="FontFamily"   Value="Segoe UI Variable Display"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="FontSize"     Value="13"/>
                <Setter Property="Cursor"       Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="20"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#9E8FFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ghost button -->
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
                <Setter Property="Background" Value="#242424"/>
                <Setter Property="Foreground" Value="#8A8A8A"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2E2E2E"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- TextBox dark style -->
            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Background"       Value="#242424"/>
                <Setter Property="Foreground"       Value="White"/>
                <Setter Property="BorderBrush"      Value="#7B61FF"/>
                <Setter Property="BorderThickness"  Value="1"/>
                <Setter Property="Padding"          Value="12,8"/>
                <Setter Property="FontFamily"       Value="Segoe UI Variable Text"/>
                <Setter Property="FontSize"         Value="13"/>
                <Setter Property="CaretBrush"       Value="#7B61FF"/>
                <Setter Property="SelectionBrush"   Value="#7B61FF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                    <TextBlock x:Name="Watermark"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="#4A4A4A"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Top"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- PasswordBox dark style -->
            <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
                <Setter Property="Background"      Value="#242424"/>
                <Setter Property="Foreground"      Value="White"/>
                <Setter Property="BorderBrush"     Value="#7B61FF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="12,8"/>
                <Setter Property="FontFamily"      Value="Segoe UI Variable Text"/>
                <Setter Property="FontSize"        Value="13"/>
                <Setter Property="CaretBrush"      Value="#7B61FF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
