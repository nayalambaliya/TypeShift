<Window x:Class="TypeShift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeShift" Height="580" Width="620"
        Background="#000000" Foreground="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI Variable Display">

    <Window.Resources>
        <!-- Tab control style -->
        <Style TargetType="TabControl">
            <Setter Property="Background"        Value="#000000"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground"     Value="#8A8A8A"/>
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="18,10"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#7B61FF"/>
                                <Setter Property="Foreground" Value="#7B61FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#9E8FFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0D0D0D" Padding="24,20,24,16">
            <StackPanel Orientation="Horizontal">
                <!-- Logo pill -->
                <Border Width="40" Height="40" CornerRadius="12"
                        BorderBrush="#111111" BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3D2BFF" Offset="0"/>
                            <GradientStop Color="#7B61FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="T›" FontSize="16" FontWeight="ExtraBold"
                               Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TypeShift" FontSize="22" FontWeight="ExtraBold" Foreground="White" LetterSpacing="-0.5"/>
                    <TextBlock x:Name="StatusLabel" Text="AI text assistant — works in every app"
                               FontSize="12" Foreground="#8A8A8A" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Separator Grid.Row="1" Background="#1A1A1A" Height="1"/>

        <!-- Tabs -->
        <TabControl Grid.Row="2" x:Name="MainTabs" Background="#000000">
            <TabItem Header="🏠  Home">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#000000">
                    <StackPanel Margin="24" x:Name="HomePanel">

                        <!-- Service status card -->
                        <Border x:Name="StatusCard" CornerRadius="18" Padding="20" Margin="0,0,0,14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A1A1A" Offset="0"/>
                                    <GradientStop Color="#0D0D0D" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#34C759" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusTitle" Text="Service active" Margin="10,0,0,0"
                                               FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock x:Name="StatusDesc"
                                           Text="TypeShift is running. Type any trigger in any app and press Space."
                                           FontSize="13" Foreground="#8A8A8A" Margin="0,10,0,0"
                                           TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <!-- Stats row -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="12"/>
                                <ColumnDefinition/><ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="14" Background="#1A1A1A" Padding="12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="19"       FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Commands" FontSize="11" Foreground="#8A8A8A" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="14" Background="#1A1A1A" Padding="12" x:Name="CustomStat">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="★"  FontSize="16" Foreground="#7B61FF" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="CustomCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Custom"   FontSize="11" Foreground="#8A8A8A" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" CornerRadius="14" Background="#1A1A1A" Padding="12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔑" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ApiKeyStat" Text="None" FontSize="20" FontWeight="Bold" Foreground="#FF3B30" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="API Key" FontSize="11" Foreground="#8A8A8A" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Quick commands -->
                        <TextBlock Text="QUICK COMMANDS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#8A8A8A" LetterSpacing="0.5" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="QuickCommandsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Tip card -->
                        <TextBlock Text="PRO TIP" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#8A8A8A" LetterSpacing="0.5" Margin="0,20,0,10"/>
                        <Border CornerRadius="16" Padding="18" BorderThickness="1" BorderBrush="#1A1040">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A1040" Offset="0"/>
                                    <GradientStop Color="#0D0D1A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0"/>
                                <StackPanel>
                                    <TextBlock Text="Tip of the day" FontSize="13" FontWeight="SemiBold" Foreground="#9E8FFF"/>
                                    <TextBlock Text="Type your text in any app, add ?formal at the end, press Space — TypeShift rewrites it in-place instantly."
                                               FontSize="13" Foreground="#8A8A8A" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- COMMANDS TAB -->
            <TabItem Header="⚡  Commands">
                <Grid Background="#000000">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="CommandsScroll">
                        <StackPanel Margin="24" x:Name="CommandsPanel">

                            <DockPanel Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Commands" FontSize="24" FontWeight="ExtraBold" Foreground="White"/>
                                    <TextBlock x:Name="CommandsCountLabel" Text="19 built-in" FontSize="12" Foreground="#8A8A8A"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="+ New Command" Style="{StaticResource AccentButton}"
                                        VerticalAlignment="Center" Click="AddCommand_Click"/>
                            </DockPanel>

                            <!-- Built-in -->
                            <TextBlock Text="BUILT-IN" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" LetterSpacing="0.5" Margin="0,0,0,8"/>
                            <Border CornerRadius="16" Background="#1A1A1A" x:Name="BuiltinList" Margin="0,0,0,20">
                                <ItemsControl x:Name="BuiltinCommandsList" Margin="4"/>
                            </Border>

                            <!-- My Commands -->
                            <TextBlock Text="MY COMMANDS" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" LetterSpacing="0.5" Margin="0,0,0,8"/>
                            <Border CornerRadius="16" Background="#1A1A1A" x:Name="CustomListContainer">
                                <ItemsControl x:Name="CustomCommandsList" Margin="4"/>
                            </Border>

                            <Border x:Name="EmptyCustomPlaceholder" CornerRadius="16" BorderBrush="#242424"
                                    BorderThickness="1" Padding="32" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✦" FontSize="28" HorizontalAlignment="Center" Foreground="#444444"/>
                                    <TextBlock Text="No custom commands yet" FontSize="14" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                    <TextBlock Text="Click &quot;+ New Command&quot; to create one"
                                               FontSize="13" Foreground="#8A8A8A" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- EXPLORE TAB -->
            <TabItem Header="🧭  Explore">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#000000">
                    <StackPanel Margin="24">
                        <TextBlock Text="Explore" FontSize="24" FontWeight="ExtraBold" Foreground="White"/>
                        <TextBlock Text="Discover what TypeShift can do" FontSize="13" Foreground="#8A8A8A" Margin="0,2,0,20"/>

                        <!-- How it works -->
                        <Border CornerRadius="16" Padding="20" Margin="0,0,0,20" BorderThickness="1" BorderBrush="#1A1040">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A1040" Offset="0"/>
                                    <GradientStop Color="#0D1A20" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="How it works" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#7B61FF22" Margin="0,0,12,0">
                                        <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="#9E8FFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Type your text in any app on Windows" FontSize="13" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#7B61FF22" Margin="0,0,12,0">
                                        <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="#9E8FFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Append a command like ?fix or ?formal" FontSize="13" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#7B61FF22" Margin="0,0,12,0">
                                        <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="#9E8FFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Press Space — TypeShift rewrites it in-place instantly" FontSize="13" Foreground="#8A8A8A" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="USE CASES" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" LetterSpacing="0.5" Margin="0,0,0,10"/>

                        <!-- Use case cards -->
                        <ItemsControl x:Name="UseCasesList"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SETTINGS TAB -->
            <TabItem Header="⚙️  Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#000000">
                    <StackPanel Margin="24">
                        <TextBlock Text="Settings" FontSize="24" FontWeight="ExtraBold" Foreground="White" Margin="0,0,0,20"/>

                        <!-- API Key -->
                        <Border CornerRadius="18" Background="#1A1A1A" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🔑 " FontSize="16"/>
                                    <TextBlock Text="Groq API Key" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="Free, fast, no credit card required" FontSize="13" Foreground="#8A8A8A" Margin="0,0,0,12"/>
                                <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource DarkPasswordBox}"
                                             Margin="0,0,0,12" PasswordChanged="ApiKeyBox_PasswordChanged"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save" Style="{StaticResource AccentButton}" Width="80"
                                            Click="SaveApiKey_Click" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="ApiKeySavedLabel" Text="✓  Saved" Visibility="Collapsed"
                                               FontSize="13" FontWeight="Medium" Foreground="#34C759" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Get your free key at console.groq.com" FontSize="12" Foreground="#444444" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Temperature -->
                        <Border CornerRadius="18" Background="#1A1A1A" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🌡️ " FontSize="16"/>
                                    <TextBlock Text="AI Temperature" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="Controls how creative or precise the AI output is." FontSize="13" Foreground="#8A8A8A" Margin="0,0,0,14"/>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="TempLabel"  DockPanel.Dock="Left"  FontSize="15" FontWeight="SemiBold" Foreground="#7B61FF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TempValue"  DockPanel.Dock="Right" FontSize="13" FontWeight="Bold"    Foreground="#7B61FF" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Slider x:Name="TempSlider" Minimum="0" Maximum="1.5" TickFrequency="0.1"
                                        IsSnapToTickEnabled="True" ValueChanged="TempSlider_Changed"
                                        Foreground="#7B61FF"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="0.0  Precise" DockPanel.Dock="Left"  FontSize="11" Foreground="#444444"/>
                                    <TextBlock Text="1.5  Wild"    DockPanel.Dock="Right" FontSize="11" Foreground="#444444" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Model info -->
                        <Border CornerRadius="18" Background="#1A1A1A" Padding="20" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3D2BFF" Offset="0"/>
                                            <GradientStop Color="#7B61FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="AI Model" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="llama-3.3-70b-versatile" FontSize="13" Foreground="#9E8FFF" Margin="0,2,0,0"/>
                                    <TextBlock Text="via Groq — ~300ms response time" FontSize="12" Foreground="#8A8A8A" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- About -->
                        <Border CornerRadius="18" Background="#1A1A1A" Padding="20">
                            <StackPanel>
                                <TextBlock Text="About" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                <Separator Background="#242424" Margin="0,0,0,10"/>
                                <DockPanel Margin="0,0,0,6"><TextBlock Text="Version"  Foreground="#8A8A8A"/><TextBlock Text="1.0"     Foreground="White" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel>
                                <DockPanel Margin="0,0,0,6"><TextBlock Text="Platform" Foreground="#8A8A8A"/><TextBlock Text="Windows 10+" Foreground="White" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel>
                                <DockPanel><TextBlock Text="Trigger"  Foreground="#8A8A8A"/><TextBlock Text="Space key" Foreground="White" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel>
                                <Separator Background="#242424" Margin="0,10"/>
                                <TextBlock Text="TypeShift works in every Windows app — Notepad, Word, VS Code, browsers, and more."
                                           FontSize="13" Foreground="#8A8A8A" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
